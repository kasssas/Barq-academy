# Application environment variables
# Copy this file to config/app.env and fill in real values.
# Never commit config/app.env to version control.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://barq_app:change_me_password@postgres:5432/barq_tasks

# Redis connection string
REDIS_URL=redis://redis:6379/0
